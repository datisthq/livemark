{
  "name": "livemark",
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "source/entrypoints/worker.ts",
  "compatibility_date": "2026-04-01",
  "preview_urls": true,
  "workers_dev": true,
  "build": {
    "command": "pnpm build:docs",
  },
  "assets": {
    "directory": ".livemark/build/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "routes": [
    {
      "pattern": "livemark.dev",
      "custom_domain": true,
    },
  ],
}
