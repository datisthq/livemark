    "es-toolkit": "1.52.0",
    "github-slugger": "^2.0.0",
    "input-otp": "1.5.0",
    "katex": "catalog:",
    "lucide-react": "0.577.0",
    "mdast-util-directive": "^3.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.1.0",
    "npm-to-yarn": "^3.2.0",
    "picocolors": "1.1.1",
    "react-day-picker": "10.0.2",
    "react-medium-image-zoom": "^5.4.9",
    "react-resizable-panels": "4.14.4",
