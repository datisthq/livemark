{
  "name": "livemark",
  "version": "0.28.4",
  "description": "Livemark description",
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/livemark",
  "bin": {
    "livemark": "./build/entrypoints/main.js"
  },
  "files": [
    "build",
    "source",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./build/index.js",
    "./components/*": "./source/components/*.tsx",
    "./elements/*": "./source/elements/*.tsx",
    "./hooks/*": "./source/hooks/*.ts",
    "./styles/*": "./source/styles/*.css",
    "./env": "./source/env.d.ts"
  },
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "build:docs": "node source/entrypoints/main.ts build",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "vp fmt --check && vp lint",
    "check:types": "tsgo --noEmit",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "measure:coverage": "vp test --run --coverage",
    "prepare": "lefthook install && node scripts/link-skills.ts",
    "release": "pnpm publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm scan:leaks && pnpm scan:vulns",
    "scan:leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "scan:vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "squash": "node scripts/squash-branch.ts",
    "start": "node source/entrypoints/main.ts start",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "vp test",
    "update:deps": "ncu -u --cooldown 7d"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clack/prompts": "1.8.1",
    "@content-collections/core": "0.15.3",
    "@content-collections/integrations": "0.5.0",
    "@content-collections/mdx": "0.2.2",
    "@orama/orama": "^3.1.18",
    "@shikijs/rehype": "4.5.0",
    "@shikijs/twoslash": "^4.5.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-hotkeys": "^0.13.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-devtools": "5.104.2",
    "@tanstack/react-router": "1.170.42",
