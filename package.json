{
  "name": "livemark-repo",
  "version": "0.46.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:docs": "node --conditions=source livemark/source/entrypoints/main.ts build",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "vp fmt --check && vp lint",
    "check:types": "tsgo --noEmit",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "measure:coverage": "vp test --run --coverage",
    "prepare": "lefthook install && node .scripts/link-skills.ts",
    "release": "pnpm -r publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm scan:leaks && pnpm scan:vulns",
    "scan:leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "scan:vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "squash": "node .scripts/squash-branch.ts",
    "start": "node --conditions=source livemark/source/entrypoints/main.ts start",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "vp test",
    "update:deps": "ncu -u --cooldown 7d --root --workspaces"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@types/hast": "3.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "catalog:",
    "cn": "0.4.0",
    "lefthook": "2.2.1",
    "livemark": "workspace:*",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tempy": "3.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
