    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-definition-list": "^2.0.1",
    "remark-directive": "^4.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "4.0.1",
