    "@tanstack/react-start": "1.168.61",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
